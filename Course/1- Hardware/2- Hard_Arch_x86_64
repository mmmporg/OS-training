================================================================================
PARTIE 11 : APIC (Advanced Programmable Interrupt Controller)
================================================================================

11.1 Local APIC
----------------
- Chaque CPU a son propre Local APIC
- Gère les interruptions locales (timer, IPI, etc.)
- Adresse de base : 0xFEE00000 (ou configurable via MSR 0x1B)

Registres Local APIC :
- 0x0020 : ID Register
- 0x0030 : Version Register
- 0x0080 : Task Priority Register (TPR)
- 0x00B0 : End Of Interrupt (EOI)
- 0x00D0 : Logical Destination Register
- 0x00E0 : Destination Format Register
- 0x00F0 : Spurious Interrupt Vector Register
- 0x0100 : In-Service Register (ISR)
- 0x0180 : Interrupt Request Register (IRR)
- 0x0200 : Error Status Register
- 0x0280 : LVT CMCI Register
- 0x0290 : LVT Timer Register
- 0x02A0 : LVT Thermal Sensor Register
- 0x02B0 : LVT Performance Monitor Register
- 0x02C0 : LVT LINT0 Register
- 0x02D0 : LVT LINT1 Register
- 0x02E0 : LVT Error Register
- 0x0300 : Initial Count Register
- 0x0380 : Current Count Register
- 0x03E0 : Divide Configuration Register
- 0x03F0 : Interrupt Command Register (ICR)

11.2 I/O APIC
--------------
- Gère les interruptions externes
- Redirige vers le(s) Local APIC(s)
- Plusieurs I/O APICs possibles

11.3 Initialiser le Local APIC
-------------------------------

bits 64
section .text
global init_apic

init_apic:
    ; Activer le Local APIC via MSR
    mov ecx, 0x1B                   ; APIC_BASE MSR
    rdmsr
    or eax, 0x800                   ; BSP + Enable
    wrmsr
    
    ; Configurer Spurious Interrupt
    mov rsi, 0xFEE000F0             ; SVR
    mov eax, [rsi]
    or eax, 0x100 | 0xFF            ; Enable + Vector 255
    mov [rsi], eax
    
    ; Configurer le timer (one-shot)
    mov rsi, 0xFEE00320             ; LVT Timer
    mov dword [rsi], 0x20000 | 32   ; Vector 32
    
    ; Configurer le diviseur
    mov rsi, 0xFEE003E0             ; Divide Config
    mov dword [rsi], 0x3            ; Divide by 16
    
    ret

11.4 Envoyer un IPI (Inter-Processor Interrupt)
------------------------------------------------

send_ipi:
    ; Destination : dans rdi
    ; Vector : dans rsi
    mov rdx, rdi
    shl rdx, 24
    
    mov eax, rsi
    or eax, 0x4000                  ; Fixed delivery
    
    mov rdi, 0xFEE00310             ; ICR high
    mov [rdi], edx
    
    mov rdi, 0xFEE00300             ; ICR low
    mov [rdi], eax
    
.wait:
    mov eax, [rdi]
    test eax, 0x1000                ; Delivery status
    jnz .wait
    
    ret

