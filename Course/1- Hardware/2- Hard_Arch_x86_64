PARTIE 9 : GESTION DE LA MEMOIRE VIRTUELLE
================================================================================

9.1 Espace d'adressage 48 bits
-------------------------------
```
0x0000000000000000 - 0x00007FFFFFFFFFFF : Canonical (User space, 128 To)
0x0000800000000000 - 0xFFFF7FFFFFFFFFFF : Non-canonical (génère #GP)
0xFFFF800000000000 - 0xFFFFFFFFFFFFFFFF : Canonical (Kernel space, 128 To)
```

9.2 Adresses canoniques
------------------------
Une adresse est canonique si les bits 63-48 sont une extension du bit 47 :
- Si bit 47 = 0 → bits 63-48 = 0
- Si bit 47 = 1 → bits 63-48 = 1

9.3 Exemple d'allocateur de pages virtuelles
---------------------------------------------

En C :

typedef struct {
    uint64_t *pml4;
} page_table_t;

void map_page(page_table_t *pt, uint64_t virt, uint64_t phys, uint64_t flags) {
    uint64_t pml4_idx = (virt >> 39) & 0x1FF;
    uint64_t pdpt_idx = (virt >> 30) & 0x1FF;
    uint64_t pdt_idx = (virt >> 21) & 0x1FF;
    uint64_t pt_idx = (virt >> 12) & 0x1FF;
    
    // PML4 → PDPT
    if (!(pt->pml4[pml4_idx] & 1)) {
        // Allouer une nouvelle PDPT
        uint64_t pdpt = allocate_frame();
        pt->pml4[pml4_idx] = pdpt | 3;  // Present + R/W
    }
    uint64_t *pdpt = (uint64_t *)(pt->pml4[pml4_idx] & ~0xFFF);
    
    // PDPT → PDT
    if (!(pdpt[pdpt_idx] & 1)) {
        uint64_t pdt = allocate_frame();
        pdpt[pdpt_idx] = pdt | 3;
    }
    uint64_t *pdt = (uint64_t *)(pdpt[pdpt_idx] & ~0xFFF);
    
    // PDT → PT
    if (!(pdt[pdt_idx] & 1)) {
        uint64_t pt = allocate_frame();
        pdt[pdt_idx] = pt | 3;
    }
    uint64_t *pt_entry = (uint64_t *)(pdt[pdt_idx] & ~0xFFF);
    
    // PT → Page physique
    pt_entry[pt_idx] = phys | flags;
}

